PORT=3000
PUBLIC_URL=http://localhost:5173
NODE_ENV=development
JWT_SECRET=replace-with-at-least-48-random-characters-before-deployment
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
ADMIN_REGISTRATION_CODE=replace-admin-registration-code
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PAYMENT_LINK=
UPSTOX_ANALYTICS_TOKEN=
INITIAL_PAPER_CASH=100000
REPLAY_CANDLE_MS=2000
# DATA_DIR must be an absolute path on a persistent disk in production.
# DATA_DIR=/var/lib/indai
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DEMO_MODE=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
